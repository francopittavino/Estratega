generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Player {
  id        String   @id @default(cuid())
  name      String
  photoUrl  String?
  wins      Int      @default(0)
  createdAt DateTime @default(now())

  participations GameParticipant[]
  trucoMembers   TrucoMember[]

  @@index([name])
}

enum GameStatus {
  IN_PROGRESS
  FINISHED
}

model Game {
  id                String     @id @default(cuid())
  status            GameStatus @default(IN_PROGRESS)
  createdAt         DateTime   @default(now())
  finishedAt        DateTime?
  // Hash del identificador del dispositivo que creo la partida: solo ese
  // puede anotar puntos. Null = partida vieja (anterior a esta funcion),
  // que queda abierta para cualquiera. Ver src/lib/owner.ts.
  ownerKey          String?
  // Contrasena elegida al crear la partida, hasheada (scrypt). Es la que
  // usa el dueno para recuperar el control si pierde la cookie. Null = no
  // puso ninguna; en ese caso solo sirve la contrasena maestra.
  ownerPasswordHash String?

  participants GameParticipant[]
  rounds       Round[]
}

model GameParticipant {
  id          String  @id @default(cuid())
  gameId      String
  playerId    String
  totalPoints Int     @default(0)
  isWinner    Boolean @default(false)

  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player      Player       @relation(fields: [playerId], references: [id])
  roundScores RoundScore[]

  @@unique([gameId, playerId])
}

model Round {
  id       String    @id @default(cuid())
  gameId   String
  number   Int
  closedAt DateTime?

  game   Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  scores RoundScore[]

  @@unique([gameId, number])
}

model RoundScore {
  id            String @id @default(cuid())
  roundId       String
  participantId String
  points        Int

  round       Round           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participant GameParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([roundId, participantId])
}

// ---------------------------------------------------------------------------
// Truco: anotador aparte de El Estratega, con su propio ranking por equipo.
// ---------------------------------------------------------------------------

enum TrucoTeam {
  A
  B
}

model TrucoGame {
  id                String     @id @default(cuid())
  // 1 = solitario (1 vs 1), 2 = dúo (2 vs 2), 3 = trío (3 vs 3).
  teamSize          Int
  status            GameStatus @default(IN_PROGRESS)
  pointsA           Int        @default(0)
  pointsB           Int        @default(0)
  winnerTeam        TrucoTeam?
  // Hash del identificador del dispositivo que creó la partida: solo ese
  // puede sumar o restar puntos. Ver src/lib/owner.ts.
  ownerKey          String?
  // Contrasena elegida al crear la partida, hasheada (scrypt). Es la que
  // usa el dueno para recuperar el control si pierde la cookie. Null = no
  // puso ninguna; en ese caso solo sirve la contrasena maestra.
  ownerPasswordHash String?
  createdAt         DateTime   @default(now())
  finishedAt        DateTime?

  members TrucoMember[]
}

model TrucoMember {
  id       String    @id @default(cuid())
  gameId   String
  playerId String
  team     TrucoTeam

  game   TrucoGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player    @relation(fields: [playerId], references: [id])

  @@unique([gameId, playerId])
  @@index([gameId])
}
